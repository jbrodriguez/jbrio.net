#!/usr/bin/env bash
#
# publish <slug> [--token TOKEN] [--dry-run]  --  take a staged post live in
# one act.
#
#   scripts/publish 202638 --token (pass show pixelfed/jbrio)
#
# Order matters, and it is the whole point of this script:
#
#   1. build, so a broken post fails here and not after something is public
#   2. post the cover photo to Pixelfed  -> it hands back a status id
#   3. write that id into the post's `pixelfed:` field
#   4. amend it into the post's own commit
#   5. squash the staging branch into one commit on main and push once
#
# Step 5 is a squash merge, so main gets exactly one commit per post however
# many commits the staging branch accumulated (frontmatter fix, then alt text,
# then a typo). Its message is the staging branch's first commit subject, so
# whatever convention the post was committed under -- `notes 202641`, `the
# anomaly review` -- carries over instead of being invented here.
#
# One consequence worth knowing when you clean up: a squash builds a new commit
# on main, so stage/<slug> is NOT an ancestor of main afterwards and
# `git branch -d stage/<slug>` refuses to delete it. Use -D.
#
# Pixelfed goes first because the id does not exist until the photo is posted.
# Doing it here rather than in the GitHub Action is what keeps the id inside the
# post's first commit -- the shape every post in data/posts already has -- and
# it means deploy.yml needs no changes, no contents:write, no bot commit and no
# second deploy.
#
# Steps 2 and 5 are both irreversible and there is no cancel window on either,
# so the script never stops between them: once the photo is on Pixelfed the
# push follows immediately. Rehearse with --dry-run, which does everything
# except the two network calls.
#
# The push to main triggers .github/workflows/deploy.yml: ssg build ->
# wrangler deploy -> announce the post to Bluesky, Mastodon and Twitter about
# 30 s later. What gets broadcast is the post's `description:` field.
#
# Token: a Pixelfed personal access token, either
#
#   --token "$(pass show pixelfed/jbrio)"      # fish: --token (pass show ...)
#   PIXELFED_ACCESS_TOKEN in the environment
#
# --token wins. Never in the repo, never written to disk by this script.
#
# One caveat on --token, because it is real and cheap to avoid: an argument is
# visible in `ps` to anything running as you for the few seconds this script
# takes. If that matters on a shared machine, put it in the environment instead
# -- in fish, `set -x PIXELFED_ACCESS_TOKEN (pass show pixelfed/jbrio)`, which
# never puts the secret in an argv.
#
# PIXELFED_INSTANCE_URL is optional and defaults to pixelfed.social.
#
# Step 2 runs `pixelfed-post`, a Go program. Its source is NOT in this repo --
# it lives in ~/code/sp, alongside the other social posting code. Rebuild and
# reinstall it with:
#
#   cd ~/code/sp && go build -o ~/.local/bin/pixelfed-post ./cmd/pixelfed-post

set -euo pipefail

DRY_RUN=0
SLUG=""
TOKEN="${PIXELFED_ACCESS_TOKEN:-}"
usage() { echo "usage: scripts/publish <slug> [--token TOKEN] [--dry-run]" >&2; exit 2; }

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --token)   [ $# -ge 2 ] || { echo "--token needs a value" >&2; usage; }
               TOKEN="$2"; shift ;;
    --token=*) TOKEN="${1#--token=}" ;;
    -*)        echo "unknown option: $1" >&2; usage ;;
    *)         SLUG="$1" ;;
  esac
  shift
done
[ -n "$SLUG" ] || usage

cd "$(git rev-parse --show-toplevel)"

POST="data/posts/$SLUG/index.md"
IMAGE="data/posts/$SLUG/$SLUG-full.jpg"
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Message for the squash commit at the end: the staging branch's first commit
# subject. Read before the amend below so it is the post's own subject and not
# "pixelfed: record status id ...". Empty when BRANCH is main, where no merge
# happens.
SQUASH_MSG=$(git log --format=%s --reverse "main..$BRANCH" | head -1)

die() { echo "publish: $*" >&2; exit 1; }

# --- preflight: everything that can say no, before anything goes public ------

[ -f "$POST" ]  || die "no such post: $POST"
[ -f "$IMAGE" ] || die "no $IMAGE -- that is the photo Pixelfed gets"

[ -z "$(git status --porcelain)" ] || die "working tree is dirty -- commit or stash first"

EXISTING=$(sed -n "s/^pixelfed: *['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\} *$/\1/p" "$POST")
if [ -n "$EXISTING" ]; then
  echo "publish: $SLUG already has pixelfed: $EXISTING -- the photo has been posted." >&2
  echo "         If that id is committed but the push failed, finish by hand:" >&2
  if [ "$BRANCH" = "main" ]; then
    echo "           git push origin main" >&2
  else
    echo "           git checkout main && git merge --squash $BRANCH && git commit -m '$SQUASH_MSG' && git push origin main" >&2
  fi
  exit 1
fi

# The merge into main happens at the end of this script, after the photo is
# already public. A merge that fails there leaves the photo posted with nothing
# pushed, so assert here that it can happen. This narrows the window, it does
# not close it -- a push to main landing between here and the merge still loses
# -- but a main that diverged hours ago gets caught before anything is public.
git fetch --quiet origin || die "git fetch origin failed -- cannot tell whether main is up to date.
         Fix the remote or the network, then try again."

[ "$(git rev-parse main)" = "$(git rev-parse origin/main)" ] || die "main and origin/main differ -- the push at the end would be rejected.
         Reconcile first:  git checkout main && git pull --ff-only"

if [ "$BRANCH" != "main" ]; then
  git merge-base --is-ancestor main HEAD || die "main is not an ancestor of $BRANCH -- the merge at the end would fail.
         Rebase this branch onto main first:  git rebase main"

  [ -n "$SQUASH_MSG" ] || die "$BRANCH has no commits of its own relative to main -- there is nothing to squash."
fi

grep -q "^alt:" "$POST" || die "$POST has no \`alt:\` -- Pixelfed would get the photo with no alt text"

# Three front-matter fields feed three public surfaces, so all three are gated
# here. `caption:` is the newest: pixelfed-post posts it, minus its ` © credit`
# suffix, as the Pixelfed caption, so a post without one goes out a bare photo.
#
# This must agree with captionFromField in ~/code/sp/cmd/pixelfed-post: drop the
# credit from the first spaced ©, and treat a credit-only caption as having no
# subject at all -- `caption: '© Juan B. Rodriguez'` is a real shape in
# data/posts (202612, 202626, 202634) and posting that bare credit as a caption
# would be worse than refusing.
CAPTION=$(sed -n 's/^caption: *//p' "$POST" | sed 's/^["'"'"']//;s/["'"'"']$//;s/ ©.*//;s/^©.*//;s/ *$//')
[ -n "$CAPTION" ] || die "$POST has no \`caption:\` subject -- that is the Pixelfed caption.
         It needs a subject before the credit:  caption: \"street lamp © Juan B. Rodriguez\""

DESCRIPTION=$(sed -n 's/^description: *//p' "$POST" | sed 's/^["'"'"']//;s/["'"'"']$//')
[ -n "$DESCRIPTION" ] || die "$POST has no \`description:\` -- that is the text broadcast to three networks"

# The theme's CSS is Tailwind v4 syntax (@import "tailwindcss", @plugin,
# @source). A v3 tailwindcss earlier on PATH -- the rbenv shim is v3.4.1 and
# sits ahead of ~/.local/bin -- makes `ssg build` below die with a postcss
# "Failed to find 'tailwindcss'" stack trace. Say the actual cause instead.
TAILWIND=$(command -v tailwindcss || true)
[ -n "$TAILWIND" ] || die "no tailwindcss on PATH -- ssg build needs it"
TAILWIND_MAJOR=$("$TAILWIND" --help 2>&1 | sed -n 's/.*tailwindcss v\([0-9]*\).*/\1/p' | head -1)
[ "$TAILWIND_MAJOR" = "4" ] || die "$TAILWIND is v${TAILWIND_MAJOR:-?}; the theme needs v4.
         Try:  PATH=\"\$HOME/.local/bin:\$PATH\" scripts/publish $SLUG"

command -v pixelfed-post >/dev/null || die "no pixelfed-post on PATH -- step 2 needs it.
         Build it:  cd ~/code/sp && go build -o ~/.local/bin/pixelfed-post ./cmd/pixelfed-post"

[ -n "$TOKEN" ] || die "no Pixelfed token. Pass one:
           scripts/publish $SLUG --token (pass show pixelfed/jbrio)"
export PIXELFED_ACCESS_TOKEN="$TOKEN"

echo "==> building"
ssg build >/dev/null || die "ssg build failed -- nothing was posted or pushed"

# Amend when HEAD is the commit that added this post, so the id ends up in the
# post's own commit. Otherwise take a separate commit rather than rewriting
# somebody else's work.
AMEND=1
while IFS= read -r f; do
  case "$f" in "data/posts/$SLUG/"*) ;; *) AMEND=0 ;; esac
done < <(git show --name-only --format= HEAD | sed '/^$/d')

# --- the point of no return -------------------------------------------------

cat <<EOF

  post        $SLUG  ($BRANCH $(git rev-parse --short HEAD))
  photo       $IMAGE  ($(wc -c < "$IMAGE" | tr -d ' ') bytes)
  caption     $CAPTION
  broadcast   $DESCRIPTION
  commit      $([ "$AMEND" = 1 ] && echo "amend HEAD" || echo "new commit on $BRANCH")

  This posts the photo to Pixelfed, then pushes to main. The push deploys the
  site and announces it to Bluesky, Mastodon and Twitter. Neither can be undone.

EOF

if [ "$DRY_RUN" = 1 ]; then
  echo "  --dry-run: stopping here. Nothing posted, nothing pushed."
  exit 0
fi

read -r -p "  Publish $SLUG? [y/N] " reply
case "$reply" in y|Y|yes) ;; *) echo "  aborted."; exit 1 ;; esac

echo "==> posting to Pixelfed"
ID=$(pixelfed-post "$POST")
[ -n "$ID" ] || die "Pixelfed returned no status id -- nothing pushed"
git diff --quiet -- "$POST" && die "pixelfed id $ID was not written to $POST -- nothing pushed"

echo "==> recording pixelfed: $ID"
git add "data/posts/$SLUG"
if [ "$AMEND" = 1 ]; then
  git commit --quiet --amend --no-edit
else
  git commit --quiet -m "pixelfed: record status id for $SLUG"
fi

echo "==> pushing"
if [ "$BRANCH" != "main" ]; then
  git checkout --quiet main
  # --squash stages the work and writes .git/SQUASH_MSG but does not commit, so
  # the commit is explicit -- a bare `git commit` would open $EDITOR and hang.
  { git merge --squash "$BRANCH" && git commit --quiet -m "$SQUASH_MSG"; } || die "the photo is live on Pixelfed and the id is committed on $BRANCH, but squashing it into main failed.
         Nothing has been broadcast. Finish by hand:
           git checkout main && git merge --squash $BRANCH && git commit -m '$SQUASH_MSG' && git push origin main"
fi
git push origin main || die "the photo is live on Pixelfed and the id is committed, but the push failed.
         Nothing has been broadcast. Fix the remote, then:  git push origin main"

cat <<EOF

  done.

  post      https://jbrio.net/posts/$SLUG/
  pixelfed  https://pixelfed.social/p/jbrodriguez/$ID

  The deploy and the social announce are running in the Action now.
EOF
